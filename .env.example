# Local media storage for development
MEDIA_STORAGE_DIR=data/uploads

# Optional local creative-attribution metadata directory
CREATIVE_ATTRIBUTION_DIR=data/creative-attribution

# 10 MB
MAX_UPLOAD_BYTES=10485760

# Required for production media storage (server-only)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=

# Optional stable public app origin for creative image URLs.
# Example: https://your-production-domain.com
# If omitted on Vercel, VERCEL_PROJECT_PRODUCTION_URL is used when available.
CREATIVE_PUBLIC_BASE_URL=

# Required for creative generation (server-only)
OPENAI_API_KEY=

# Optional provider/model overrides
OPENAI_ANALYSIS_MODEL=gpt-5.6-terra
OPENAI_TEXT_MODEL=gpt-5.6-terra
OPENAI_IMAGE_MODEL=gpt-image-2

# Required for one-click public Meta creative discovery.
# Phase 1 uses a replaceable Apify Meta Ad Library provider rather than scraping Meta directly.
APIFY_TOKEN=

# Optional discovery overrides
APIFY_META_ADS_ACTOR_ID=apify~facebook-ads-scraper
WINNING_CREATIVE_SEARCH_TERMS=tax debt relief,IRS tax debt,owe the IRS,back taxes help,tax resolution,IRS tax relief,settle tax debt

# Required for Send to Meta (server-only)
META_ACCESS_TOKEN=

# Optional Meta API version override. v25.0 is current as of August 2026.
META_GRAPH_API_VERSION=v25.0

# Optional Meta URL-parameter override. If omitted, TRA's default external ROI template is used.
META_URL_TAGS=_ef_transaction_id=&source_id=&affid=6&sub1={{campaign.id}}&sub2={{adset.id}}&sub3={{ad.id}}&sub4={{placement}}&sub5=ci&oid=73
