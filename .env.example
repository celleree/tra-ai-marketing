# Local media storage for development
MEDIA_STORAGE_DIR=data/uploads

# Clerk authentication (required to enable configured-session entry)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Optional local creative-attribution metadata directory
CREATIVE_ATTRIBUTION_DIR=data/creative-attribution

# 10 MB
MAX_UPLOAD_BYTES=10485760

# 100 MB
MAX_VIDEO_UPLOAD_BYTES=104857600

# Opt-in local extraction validation (set in the shell before running Vitest).
# npm test -- tests/video/real-video.validation.test.ts
TRA_VIDEO_VALIDATION_INPUT=
# Optional expected scene-change windows in milliseconds, e.g. [[2200,2300]].
TRA_VIDEO_VALIDATION_SCENES=[]
# Opt-in paid OpenAI transcription during local validation (MP4 up to 25 MB).
TRA_VIDEO_VALIDATION_TRANSCRIPT=0
# Include Phase 2 technical scores and duplicate groups in the local report.
TRA_VIDEO_VALIDATION_TECHNICAL=0
# Opt-in paid vision analysis of every technical representative.
TRA_VIDEO_VALIDATION_VISION=0

# Required for production media storage (server-only)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=

# Optional stable public app origin for creative image URLs.
# Example: https://your-production-domain.com
# If omitted on Vercel, VERCEL_PROJECT_PRODUCTION_URL is used when available.
CREATIVE_PUBLIC_BASE_URL=

# Required for creative generation (server-only)
OPENAI_API_KEY=

# Optional Claude creative copilot (server-only; disabled by default).
# Operator keys are entered only in Copilot settings; no shared key fallback.
# Configure a server Secret containing canonical base64 of 32 random bytes.
# Preserve the master key across deployments; rotation needs a separate migration.
# Never use NEXT_PUBLIC_ for any credential or master key.
TRA_PROVIDER_SECRETS_MASTER_KEY=
TRA_CLAUDE_COPILOT_ENABLED=false
TRA_CLAUDE_COPILOT_ALLOW_PAID=false
TRA_CLAUDE_COPILOT_BYOK_ALLOW_PAID=false

# Wan 2.2 Animate via Fal; disabled until provider, transfer and budget approval.
WAN_ACCESS_ENABLED=false
WAN_PAID_ENABLED=false
FAL_KEY=
# Per-job estimated cost ceiling, maximum $5; estimate is not a provider billing cap.
WAN_MAX_ESTIMATED_USD=1

# Creative discovery: authorized Apify access and budget required before enabling.
DISCOVERY_PROVIDER_ACCESS_APPROVED=false
DISCOVERY_PAID_EXECUTION_ENABLED=false
APIFY_TOKEN=
# Separate optional selected-image analysis; uses OPENAI_API_KEY/ANALYSIS_MODEL.
DISCOVERY_VISUAL_ANALYSIS_ENABLED=false
DISCOVERY_ANALYSIS_TRANSFER_APPROVED=false

# Server-only explicit opt-in for paid images in local development, Preview, tests or CI.
# Leave blank for offline operation. To intentionally allow paid requests, use exactly:
# TRA_LIVE_IMAGE_AUTHORIZATION=allow-paid-image-generation
# Deployed Vercel production (VERCEL_ENV=production and NODE_ENV=production) needs no
# opt-in unless CI/Vitest markers are present. Local next start still requires opt-in.
# This only grants admission; image quality, fallback and other request options are unchanged.
TRA_LIVE_IMAGE_AUTHORIZATION=

# Server-only image purpose: diagnostic, staging-smoke, production.
# Default: production on Vercel Production; diagnostic elsewhere. Diagnostics use
# LOW Sunburst, one output and no fallback. Smoke/production use HIGH. All disable
# streaming/partial images. This does not itself authorize paid requests.
TRA_IMAGE_PURPOSE=

# Optional provider/model overrides
OPENAI_ANALYSIS_MODEL=gpt-6-luna
OPENAI_TEXT_MODEL=gpt-6.1-sol

# Required for Send to Meta (server-only)
META_ACCESS_TOKEN=

# Optional Meta API version override. v25.0 is current as of August 2026.
META_GRAPH_API_VERSION=v25.0

# Optional Meta URL-parameter override. If omitted, TRA's default external ROI template is used.
META_URL_TAGS=_ef_transaction_id=&source_id=&affid=6&sub1={{campaign.id}}&sub2={{adset.id}}&sub3={{ad.id}}&sub4={{placement}}&sub5=ci&oid=73
