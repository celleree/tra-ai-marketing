# Local media storage for development
MEDIA_STORAGE_DIR=data/uploads

# 10 MB
MAX_UPLOAD_BYTES=10485760

# Required for production media storage (server-only)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=

# Required for creative generation (server-only)
OPENAI_API_KEY=

# Optional provider/model overrides
OPENAI_ANALYSIS_MODEL=gpt-5.6-terra
OPENAI_TEXT_MODEL=gpt-5.6-terra
OPENAI_IMAGE_MODEL=gpt-image-2

# Required for Send to Meta (server-only)
META_ACCESS_TOKEN=

# Optional Meta API version override. v25.0 is current as of August 2026.
META_GRAPH_API_VERSION=v25.0
